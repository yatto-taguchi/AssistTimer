{
  "expo": {
    "name": "AssistTimer",
    "slug": "assisttimer",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assisttimer",
      "buildNumber": "53",
      "infoPlist": {
        "NSCameraUsageDescription": "練習の記録にウィッグや施術の写真を撮影・添付するためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "練習の記録にアルバムから写真を選択・添付するために写真ライブラリを使用します。",
        "NSPhotoLibraryAddUsageDescription": "撮影した練習の写真を端末の写真ライブラリに保存するために使用します。",
        "NSAlarmKitUsageDescription": "タイマー終了時に、マナーモード中や画面ロック中でも止めるまでアラームでお知らせするために使用します。",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "96db37f6-0068-4dab-8f29-1055c9915014"
      }
    },
    "owner": "litthairdesign",
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3646959221255515~3936890861"
        }
      ],
      "@bacons/apple-targets"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/96db37f6-0068-4dab-8f29-1055c9915014"
    }
  }
}
